{
  "name": "co3011-campus-housing",
  "version": "8.0.0",
  "private": true,
  "description": "KTX Khu A residence portal: occupancy visualizations, room status map, in-app services and responsive UI with Neon/PostgreSQL and Vercel",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.local server.js",
    "dev": "node --watch --env-file-if-exists=.env.local server.js",
    "db:setup": "node --env-file-if-exists=.env.local scripts/setup-db.js",
    "test": "node --test tests/*.test.js",
    "test:unit": "node --test tests/unit.test.js",
    "test:inspections": "node --test tests/inspections.test.js",
    "test:source": "node --test tests/source.test.js",
    "test:api": "node --test tests/api.test.js",
    "test:integration": "node --env-file-if-exists=.env.test --test tests/integration.test.js",
    "test:coverage": "node --experimental-test-coverage --test tests/*.test.js",
    "test:ui": "python scripts/visual-smoke.py",
    "test:ui:interactive": "python scripts/interactive-smoke.py",
    "check": "node --check server.js && node --check backend/app.js && npm run test:unit && npm run test:inspections && npm run test:source"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "express": "^5.1.0"
  }
}
